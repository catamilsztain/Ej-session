@{
    ViewData["Title"] = "Registrarse";
}

<div class="panel-principal">
    <h1>Registrarse</h1>

    <form id="formularioRegistro" action='@Url.Action("Verificación","Home")' method="POST" class="pila-formulario">

        @if (ViewBag.Error != null)
        {
            <div class="alerta">
                @ViewBag.Error
            </div>
        }

        <div id="erroresRegistro" class="errores-validacion" style="display:none;"></div>

        <input id="NombreUsuario" class="campo" type="text" name="NombreUsuario" placeholder="Usuario" />
        <input id="Contrasena" class="campo" type="password" name="Contraseña" placeholder="Contraseña" />
        <input id="ClaveSeguridad" class="campo" type="text" name="ClaveSeguridad" placeholder="Clave de seguridad" />
        <input id="Nombre" class="campo" type="text" name="Nombre" placeholder="Nombre" />
        <input id="Apellido" class="campo" type="text" name="Apellido" placeholder="Apellido" />

        <select name="Tipo" class="campo">
            <option value="Alumno">Alumno</option>
            <option value="Docente">Docente</option>
            <option value="Coordinador">Coordinador</option>
            <option value="Padre">Padre</option>
        </select>

        <button class="boton boton-principal" type="submit">Guardar</button>
    </form>
</div>