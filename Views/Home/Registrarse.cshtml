@{
    ViewData["Title"] = "Registrarse";
}

<form id="formRegistro" action='@Url.Action("Verificación","Home")' method="POST">

    @if (ViewBag.Error != null)
{
    <div style="color: #b00020; margin-bottom:10px;">
        @ViewBag.Error
    </div>
}

    <div id="register-errors" style="color: red;"></div>

    <input id="NombreUsuario" type="text" name="NombreUsuario" placeholder="Usuario" />

    <input id="Contrasena" type="password" name="Contraseña" placeholder="Contraseña" />

    <input id="Nombre" type="text" name="Nombre" placeholder="Nombre" />

    <input id="Apellido" type="text" name="Apellido" placeholder="Apellido" />

    <select name="Tipo">
        <option value="1">Alumno</option>
        <option value="2">Docente</option>
        <option value="3">Coordinador</option>
        <option value="4">Padre</option>
    </select>

    <input type="submit" value="Guardar" />

</form>